# Local Docker Compose settings.
POSTGRES_DB=adrobot
POSTGRES_USER=adrobot
POSTGRES_PASSWORD=adrobot-local
API_PORT=8000
WEB_PORT=5173

# Keitaro origin, for example https://tracker.example (without /admin_api/v1).
# Get a key from the tracker's Profile > API keys tab.
KEITARO_BASE_URL=
KEITARO_API_KEY=
